// ============================================================
// TwinOLED Aquarium — Board B (Right Renderer)
// ============================================================
#include <WiFi.h>
#include <esp_now.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <math.h>

// ---------- Display ----------
#define SCREEN_W 128
#define SCREEN_H 64
#define VIRTUAL_W 256
#define SAND_Y 58

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);

// ---------- ESP-NOW ----------
typedef struct {
  float f1x, f1y; int8_t f1dir; uint8_t f1tail;
  float f2x, f2y; int8_t f2dir; uint8_t f2tail;
  float snailX;   int8_t snailDir;
  uint32_t bubbleSeed;
  uint8_t magic;
} TankPacket;

TankPacket pkt;
bool haveData = false;

// ---------- Decorations (Board B local positions, 0–127) ----------
struct Plant { int x; int h; };
Plant plantsB[] = { {2, 18}, {30, 9}, {100, 16} };
const int NUM_PLANTS_B = 3;

// ---------- Drawing helpers ----------

void drawSand(Adafruit_SSD1306 &d) {
  d.fillRect(0, SAND_Y, SCREEN_W, SCREEN_H - SAND_Y, SSD1306_WHITE);
}

void drawPlant(Adafruit_SSD1306 &d, int x, int baseY, int h, uint32_t t, float phase) {
  float sway = sinf((t / 900.0f) + phase) * 1.5f;
  int topX = x + (int)sway;
  int topY = baseY - h;

  d.drawLine(x, baseY, topX, topY, SSD1306_WHITE);

  d.drawLine(x, baseY - 2, topX - 2, topY + 3, SSD1306_WHITE);
  d.drawLine(topX - 2, topY + 3, topX - 4, topY + 6, SSD1306_WHITE);

  d.drawLine(x, baseY - 3, topX + 2, topY + 4, SSD1306_WHITE);
  d.drawLine(topX + 2, topY + 4, topX + 4, topY + 7, SSD1306_WHITE);

  d.drawPixel(topX, topY - 1, SSD1306_WHITE);
  d.drawPixel(topX - 5, topY + 6, SSD1306_WHITE);
  d.drawPixel(topX + 5, topY + 7, SSD1306_WHITE);
}

void drawFish(Adafruit_SSD1306 &d, int x, int y, int dir, uint8_t phase, bool small) {
  int bodyW = small ? 5 : 8;
  int bodyH = small ? 3 : 5;

  d.fillRect(x - bodyW/2, y - bodyH/2, bodyW, bodyH, SSD1306_WHITE);
  d.fillRect(x - bodyW/2 + 1, y - bodyH/2 - 1, bodyW - 2, bodyH + 2, SSD1306_WHITE);

  int eyeX = x + (dir > 0 ? bodyW/2 - 2 : -bodyW/2 + 2);
  d.drawPixel(eyeX, y - 1, SSD1306_BLACK);

  int flap = (phase & 0x40) ? 1 : -1;
  int tailRootX = x + (dir > 0 ? -bodyW/2 : bodyW/2);
  int tailTipX  = tailRootX + (dir > 0 ? -3 : 3);
  d.drawLine(tailRootX, y, tailTipX, y - 2 - flap, SSD1306_WHITE);
  d.drawLine(tailRootX, y, tailTipX, y + 2 + flap, SSD1306_WHITE);
  d.drawLine(tailTipX, y - 2 - flap, tailTipX, y + 2 + flap, SSD1306_WHITE);
}

void drawSnail(Adafruit_SSD1306 &d, int x, int baseY, int dir) {
  int y = baseY - 1;
  d.fillRect(x - 4, y - 1, 9, 2, SSD1306_WHITE);
  d.fillCircle(x, y - 3, 3, SSD1306_WHITE);
  d.drawPixel(x, y - 3, SSD1306_BLACK);
  d.drawPixel(x + 1, y - 4, SSD1306_BLACK);
  int e = (dir > 0) ? 3 : -3;
  d.drawLine(x + e, y - 1, x + e, y - 3, SSD1306_WHITE);
  d.drawPixel(x + e, y - 4, SSD1306_WHITE);
}

void drawBubbleColumn(Adafruit_SSD1306 &d, int baseX, uint32_t seed, uint32_t t, int xOffset) {
  for (int i = 0; i < 4; i++) {
    int bx = baseX + ((seed + i * 7) % 5) - 2;
    int by = 56 - ((t / 12 + i * 14) % 56);
    int sx = bx + xOffset;
    if (sx >= 0 && sx < SCREEN_W) {
      d.drawPixel(sx, by, SSD1306_WHITE);
      d.drawPixel(sx + 1, by, SSD1306_WHITE);
      if (i % 2 == 0) d.drawPixel(sx, by - 1, SSD1306_WHITE);
    }
  }
}

// ---------- ESP-NOW callback ----------
void onReceive(const esp_now_recv_info_t*, const uint8_t* data, int len) {
  if (len != sizeof(TankPacket)) return;
  TankPacket* p = (TankPacket*)data;
  if (p->magic != 0x42) return;
  pkt = *p;
  haveData = true;
}

// ---------- Setup ----------
void setup() {
  Wire.begin(21, 22);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.display();

  WiFi.mode(WIFI_STA);
  esp_now_init();
  esp_now_register_recv_cb(onReceive);
}

// ---------- Main loop ----------
void loop() {
  uint32_t t = millis();
  display.clearDisplay();

  // plants first
  for (int i = 0; i < NUM_PLANTS_B; i++)
    drawPlant(display, plantsB[i].x, SAND_Y, plantsB[i].h, t, i + 5.0f);

  if (haveData) {
    // Everything virtual gets shifted by -128 to map onto Board B's local screen.
    drawFish(display, (int)pkt.f1x - 128, (int)pkt.f1y, pkt.f1dir, pkt.f1tail, false);
    drawFish(display, (int)pkt.f2x - 128, (int)pkt.f2y, pkt.f2dir, pkt.f2tail, true);
    drawSnail(display, (int)pkt.snailX - 128, SAND_Y, pkt.snailDir);

    // bubbles (also virtual)
    drawBubbleColumn(display, 160 - 128, pkt.bubbleSeed, t, 0);
    drawBubbleColumn(display, 220 - 128, pkt.bubbleSeed + 3, t, 0);
  }

  drawSand(display);
  display.display();
  delay(40);
}
